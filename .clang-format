# .clang-format - C style (master branch).
#
# NOTE: deliberately no `Language:` key. A `Language:` key in the FIRST document
# makes clang-format reject this whole file for every other language, e.g. a .c
# file then fails with "Configuration file(s) do(es) not support C".
#
# This branch is C. C++-only options (Standard, AccessModifierOffset,
# NamespaceIndentation, constructor initializers, template declarations, ...)
# live on the cxx_make branch.

# --- shared with cxx_make - keep this block identical on both branches ------
BasedOnStyle: Microsoft
BreakBeforeBraces: Allman
IndentWidth: 4
TabWidth: 4
# Embedded C is 80 columns: fits a serial console and side-by-side diffs.
ColumnLimit: 80
UseTab: Never
IndentCaseLabels: true
PointerAlignment: Left
BreakBeforeTernaryOperators: false
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignConsecutiveMacros: Consecutive
AlignConsecutiveAssignments:
  Enabled: true
AlignConsecutiveDeclarations:
  Enabled: true
AlignTrailingComments:
  Kind: Always
BinPackArguments: false
BinPackParameters: OnePerLine
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AlwaysBreakBeforeMultilineStrings: false
ReflowComments: true
SortIncludes: CaseSensitive
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
InsertNewlineAtEOF: true
IndentPPDirectives: AfterHash
SeparateDefinitionBlocks: Always
IncludeBlocks: Regroup
BreakAfterAttributes: Always
RemoveParentheses: ReturnStatement
# clang-format documents QualifierAlignment != Leave as capable of producing
# incorrect formatting, because it lacks full semantic information. Review the
# first `make format` diff before trusting it.
# Left gives west const (`const char *name`), which is what the ESP8266 SDK and
# essentially every embedded C codebase uses. The preset default is Leave.
QualifierAlignment: Left

# --- embedded / ESP8266 ----------------------------------------------------
# The default for AlignEscapedNewlines is Right, which pads every macro's
# trailing backslash out to ColumnLimit. Embedded code is mostly macros.
AlignEscapedNewlines: Left
# Register maps, pin tables, command tables.
AlignArrayOfStructures: Right
# Register bitfield definitions.
AlignConsecutiveBitFields: Consecutive
